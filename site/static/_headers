/resources/*
  Cache-Control: public, max-age=300
/company
  Cache-Control: public, max-age=300
/company.html
  Cache-Control: public, max-age=300
/company/*
  Cache-Control: public, max-age=300
/robots.txt
  Cache-Control: public, max-age=300
/site.webmanifest
  Cache-Control: public, max-age=300
/llms.txt
