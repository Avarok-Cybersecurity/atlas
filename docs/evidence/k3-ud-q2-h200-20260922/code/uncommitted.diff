+            "cols:hidden_over_tp",
+            "hidden/tp",
+        ),
+        (
+            "routed_up",
+            &[hidden_local, LATENT],
+            "rows:hidden_over_tp",
+            "hidden/tp",
+        ),
+        (
+            "shexp gate/up",
+            &[shexp_local, HIDDEN],
+            "rows:out_features",
+            "n/a",
+        ),
+        (
