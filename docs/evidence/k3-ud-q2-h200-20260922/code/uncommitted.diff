+            &[HIDDEN, qkv_local],
+            "cols:head_concat_then_allreduce",
+            "n/a",
+        ),
+        ("q_a_proj", &[1536, HIDDEN], "replicated", "n/a"),
+        ("q_b_proj", &[heads_local * 192, 1536], "rows:heads", "n/a"),
+        ("attn_k_b", &[heads_local, 512, 128], "rows:heads", "n/a"),
+        ("attn_v_b", &[heads_local, 128, 512], "rows:heads", "n/a"),
